RewriteEngine On

# ถ้าเรียกแบบไม่มี .php และมีไฟล์ .php จริง
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# ทำการ redirect เฉพาะ GET request ที่มี .php
RewriteCond %{THE_REQUEST} \.php
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# ป้องกันไม่ให้ redirect เมื่อเป็น POST, PUT, DELETE หรือ AJAX
RewriteCond %{REQUEST_METHOD} ^(POST|PUT|DELETE)$
RewriteRule ^(.*)\.php$ $1.php [L]

# ป้องกันการเข้าถึงไฟล์ .htaccess
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Deny access to sensitive files
<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

<Files ".env.example">
    Order Allow,Deny
    Deny from all
</Files>

<Files "DotEnv.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "helpers.php">
    Order Allow,Deny
    Deny from all
</Files>

# Deny access to log files
<FilesMatch "\.(log|txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Deny access to backup files
<FilesMatch "\.(sql|bak|backup)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';"
</IfModule>

# Disable server signature
ServerSignature Off

# Hide PHP version
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# กำหนดค่า PHP
php_value date.timezone Asia/Bangkok
php_value display_errors Off
